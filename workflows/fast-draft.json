{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Qwen Image Edit 2511" },
    "inputs": { "unet_name": "qwen_image_edit_2511_fp8_e4m3fn.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Lightning 4-step turbo" },
    "inputs": { "model": ["1", 0], "lora_name": "Qwen\\Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0 }
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["2", 0], "shift": 3.0 }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": { "title": "Composition sketch from Storyboard Studio" },
    "inputs": { "image": "{{INPUT_IMAGE}}" }
  },
  "7": {
    "class_type": "ImageScaleToTotalPixels",
    "_meta": { "title": "Normalise sketch to ~1MP" },
    "inputs": { "image": ["6", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 64 }
  },
  "14": {
    "class_type": "LoadImage",
    "_meta": { "title": "Approved authority reference 1" },
    "inputs": { "image": "{{REFERENCE_IMAGE_1}}" }
  },
  "15": {
    "class_type": "LoadImage",
    "_meta": { "title": "Approved authority reference 2" },
    "inputs": { "image": "{{REFERENCE_IMAGE_2}}" }
  },
  "8": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Positive — brief + sketch" },
    "inputs": { "clip": ["4", 0], "prompt": "{{PROMPT}}", "vae": ["5", 0], "image1": ["7", 0], "image2": ["14", 0], "image3": ["15", 0] }
  },
  "9": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Negative" },
    "inputs": { "clip": ["4", 0], "prompt": "{{NEGATIVE_PROMPT}}", "vae": ["5", 0], "image1": ["7", 0], "image2": ["14", 0], "image3": ["15", 0] }
  },
  "10": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Storyboard geometry latent",
      "note": "Qwen Image Edit receives the composition through both semantic conditioning and the VAE latent. Full denoise repaints the storyboard while retaining its subject count, scale, and blocking."
    },
    "inputs": { "pixels": ["7", 0], "vae": ["5", 0] }
  },
  "16": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "Positive multi-reference fusion" },
    "inputs": { "conditioning": ["8", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "17": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "Negative multi-reference fusion" },
    "inputs": { "conditioning": ["9", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "11": {
    "class_type": "KSampler",
    "_meta": { "title": "4 steps, CFG 1.0 — Lightning LoRA" },
    "inputs": {
      "model": ["3", 0],
      "seed": "{{SEED}}",
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["16", 0],
      "negative": ["17", 0],
      "latent_image": ["10", 0],
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["5", 0] }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": { "images": ["12", 0], "filename_prefix": "storyboard-studio/fast-draft" }
  }
}
