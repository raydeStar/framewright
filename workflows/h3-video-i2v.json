{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "MiniMax H3" },
    "inputs": { "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": { "model": ["1", 0], "shift_video": 12.0, "shift_audio": 3.0 }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": { "title": "H3 video VAE" },
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": { "title": "First frame — the ratified still" },
    "inputs": { "image": "{{INPUT_IMAGE}}" }
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Last frame — optional second anchor",
      "optionalPlaceholder": "{{LAST_FRAME_IMAGE}}",
      "note": "Storyboard Studio deletes this node and unbinds last_frame when no last frame is attached, so the same file serves single-anchor and two-anchor jobs."
    },
    "inputs": { "image": "{{LAST_FRAME_IMAGE}}" }
  },
  "7": {
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": { "title": "Framewright quality-profile render · frozen project timing" },
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "prompt": "{{PROMPT}}",
      "width": {{VIDEO_WIDTH}},
      "height": {{VIDEO_HEIGHT}},
      "length": {{VIDEO_LENGTH}},
      "first_frame": ["17", 0],
      "last_frame": ["18", 0]
    }
  },
  "8": { "class_type": "BasicGuider", "inputs": { "model": ["2", 0], "conditioning": ["7", 0] } },
  "9": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" } },
  "10": { "class_type": "BasicScheduler", "inputs": { "model": ["2", 0], "scheduler": "simple", "steps": {{VIDEO_STEPS}}, "denoise": 1.0 } },
  "11": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["11", 0], "guider": ["8", 0], "sampler": ["9", 0], "sigmas": ["10", 0], "latent_image": ["7", 1] }
  },
  "13": { "class_type": "VAEDecode", "inputs": { "samples": ["12", 0], "vae": ["4", 0] } },
  "14": {
    "class_type": "CreateVideo",
    "_meta": { "title": "Silent by design — audio stays on its own editorial lanes" },
    "inputs": { "images": ["16", 0], "fps": {{VIDEO_FPS}} }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["14", 0], "filename_prefix": "{{VIDEO_FILENAME_PREFIX}}", "format": "auto", "codec": "auto" }
  },
  "16": {
    "class_type": "ImageScale",
    "_meta": { "title": "Project delivery canvas · Lanczos" },
    "inputs": { "image": ["19", 0], "upscale_method": "lanczos", "width": {{VIDEO_OUTPUT_WIDTH}}, "height": {{VIDEO_OUTPUT_HEIGHT}}, "crop": "center" }
  },
  "17": {
    "class_type": "ImageScale",
    "_meta": { "title": "First frame normalized to project proxy canvas" },
    "inputs": { "image": ["5", 0], "upscale_method": "lanczos", "width": {{VIDEO_WIDTH}}, "height": {{VIDEO_HEIGHT}}, "crop": "center" }
  },
  "18": {
    "class_type": "ImageScale",
    "_meta": { "title": "Last frame normalized to the identical project proxy canvas" },
    "inputs": { "image": ["6", 0], "upscale_method": "lanczos", "width": {{VIDEO_WIDTH}}, "height": {{VIDEO_HEIGHT}}, "crop": "center" }
  },
  "19": {
    "class_type": "ImageFromBatch",
    "_meta": { "title": "Trim H3 padding to the frozen shot duration" },
    "inputs": { "image": ["13", 0], "batch_index": 0, "length": {{VIDEO_LENGTH}} }
  }
}
