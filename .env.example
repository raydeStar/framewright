# Use a Docker-friendly forward-slash path on Windows.
FRAMEWRIGHT_CODEX_HOME=C:/Users/YourName/.codex
# Created automatically by scripts/docker.ps1. Keep this workstation-only.
FRAMEWRIGHT_VOICE_WORKER_TOKEN=replace-with-a-long-random-token
# Written by scripts/setup.ps1. Every submission lane fails closed by default.
FRAMEWRIGHT_COMFYUI_ENDPOINT=http://host.docker.internal:8188
FRAMEWRIGHT_COMFYUI_ALLOW_REMOTE=false
FRAMEWRIGHT_COMFYUI_STILLS_ENABLED=false
FRAMEWRIGHT_COMFYUI_VIDEO_ENABLED=false
FRAMEWRIGHT_YUE2_ENABLED=false
FRAMEWRIGHT_YUE2_ENDPOINT=http://host.docker.internal:5182
FRAMEWRIGHT_YUE2_WORKER_TOKEN=replace-with-a-long-random-token
FRAMEWRIGHT_YUE2_MODEL=m-a-p/YuE2-3B
FRAMEWRIGHT_YUE2_VAE=m-a-p/YuE2-Vae
FRAMEWRIGHT_YUE2_DEVICE=cuda
FRAMEWRIGHT_CODEX_IMAGEGEN_ENABLED=false
FRAMEWRIGHT_LOCAL_VOICE_ENABLED=false
