{
  "name": "framewright-web",
  "private": true,
  "version": "0.1.0",
  "description": "Tablet-friendly local production workspace for intentional AI-assisted shot development.",
  "author": "raydeStar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/raydeStar/framewright.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format:check": "prettier --check package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js .prettierrc.json",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/three": "0.186.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.0"
  }
}
