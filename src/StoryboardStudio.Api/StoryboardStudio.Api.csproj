<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Framewright</AssemblyName>
    <Product>Framewright</Product>
    <Title>Framewright</Title>
    <Description>Build every shot with intention.</Description>
    <!-- Keep the checked-in lock usable for both the Linux container and the
         self-contained Windows package. Release restores must never mutate it. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoryboardStudio.Core\StoryboardStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StoryboardStudio.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Content Include="..\..\workflows\**" Link="workflows\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\voice\qwen_voice_tool.py" Link="tools\voice\qwen_voice_tool.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\voice\qwen_voice_worker.py" Link="tools\voice\qwen_voice_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\voice\prefetch_qwen_voice_models.py" Link="tools\voice\prefetch_qwen_voice_models.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\voice\verify_qwen_voice_runtime.py" Link="tools\voice\verify_qwen_voice_runtime.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\voice\requirements.lock.txt" Link="tools\voice\requirements.lock.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\voice\models.lock.json" Link="tools\voice\models.lock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\setup-voice-worker.ps1" Link="scripts\setup-voice-worker.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\start-voice-worker.ps1" Link="scripts\start-voice-worker.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\start-installed.ps1" Link="scripts\start-installed.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\restore-backup.ps1" Link="scripts\restore-backup.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\yue2\yue2_service.py" Link="tools\yue2\yue2_service.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\yue2\requirements.txt" Link="tools\yue2\requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\setup-yue2-worker.ps1" Link="scripts\setup-yue2-worker.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\start-yue2-worker.ps1" Link="scripts\start-yue2-worker.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\stop-yue2-worker.ps1" Link="scripts\stop-yue2-worker.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
